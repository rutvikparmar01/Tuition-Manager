# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (not secret).

# TODO: RevenueCat → Project settings → API keys → Google Play public SDK key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=sk_rGamnILJjCrqVjjTXbqMucaNcodDv
# TODO: RevenueCat entitlement identifier that the `yearly_199` product unlocks
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=pro

# Set to "true" to point the dev build at the local Firebase emulators
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
# Host the device uses to reach your computer (Android emulator: 10.0.2.2, real phone: your LAN IP)
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2

# TODO: support WhatsApp number (10 digits, no +91) and privacy policy URL shown in Settings
EXPO_PUBLIC_SUPPORT_WHATSAPP=9725640057
EXPO_PUBLIC_PRIVACY_URL=https://www.whatsapp.com/legal/privacy-policy
